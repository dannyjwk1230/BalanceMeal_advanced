# Submission allowlist: retain local working material, publish only project essentials.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/gradlew
!/gradlew.bat
!/gradle/
!/app/
!/docs/

# One consolidated handoff document.
/docs/*
!/docs/TEAM_HANDOFF.md

# Android module and original prompt record.
/app/*
!/app/.gitignore
!/app/build.gradle.kts
!/app/schemas/
!/app/src/
!/app/모바일소프트웨어_프롬프트_정연호.docx

# Runtime, previews, and reproducible tests. Exclude duplicate input/spec documents.
/app/src/*
!/app/src/main/
!/app/src/debug/
!/app/src/test/
!/app/src/androidTest/

# Portable Gradle tooling, including the required wrapper JAR.
/gradle/*
!/gradle/libs.versions.toml
!/gradle/gradle-daemon-jvm.properties
!/gradle/wrapper/
/gradle/wrapper/*
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties

# Generated files and machine-specific/private configuration at any depth.
**/build/
**/.gradle/
**/.kotlin/
**/.idea/
**/.externalNativeBuild/
**/.cxx/
**/local.properties
*.iml
*.log
*.hprof
*.apk
*.aab
*.jks
*.keystore
*.keystore.lock
.env
.env.*
google-services.json
.DS_Store
Thumbs.db
~$*
